# --- Shared Google OAuth client (one client serves ALL accounts) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Account #1 (legacy single-account form) ---
# The connector path is /<MCP_SECRET>/mcp ; generate with: openssl rand -hex 32
MCP_SECRET=
# Long-lived refresh token for account #1 (npm run get-token).
GMAIL_REFRESH_TOKEN=

# --- Further accounts (multi-mailbox) ---
# Add more mailboxes here as a JSON array — no code change, just redeploy.
# Each needs its OWN secret (openssl rand -hex 32) and its OWN refresh token
# (run `npm run get-token` signed in as that account). Connector path is
# /<secret>/mcp.
#
# GMAIL_ACCOUNTS=[{"secret":"<hex>","refreshToken":"<token>","label":"firma2"}]
GMAIL_ACCOUNTS=
